.page {
  min-height: 100%;
  padding: 24rpx 24rpx 48rpx;
}

.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.brand {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.brand-mark {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #2dd4bf, #0f766e);
  color: #042f2e;
  font-size: 26rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  box-shadow: 0 10rpx 24rpx rgba(45, 212, 191, 0.24);
}

.brand-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #f8fafc;
}

.brand-sub {
  margin-top: 4rpx;
  color: #94a3b8;
  font-size: 22rpx;
}

.top-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.live-pill,
.icon-chip,
.server-bar-action,
.ghost-btn,
.preset-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.live-pill {
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.live-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.is-live {
  background: rgba(52, 211, 153, 0.16);
  color: #6ee7b7;
}

.is-live .live-dot {
  background: #34d399;
  box-shadow: 0 0 10rpx #34d399;
}

.is-idle {
  background: rgba(248, 113, 113, 0.14);
  color: #fca5a5;
}

.is-idle .live-dot {
  background: #f87171;
}

.icon-chip {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #e2e8f0;
  font-size: 22rpx;
}

.server-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(15, 23, 42, 0.72);
  border: 1rpx solid rgba(148, 163, 184, 0.16);
}

.server-bar-label {
  color: #7dd3fc;
  font-size: 20rpx;
}

.server-bar-value {
  margin-top: 6rpx;
  color: #f8fafc;
  font-size: 24rpx;
  word-break: break-all;
}

.server-bar-ws {
  margin-top: 4rpx;
  color: #67e8f9;
  font-size: 20rpx;
  word-break: break-all;
}

.server-bar-action {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(45, 212, 191, 0.14);
  color: #5eead4;
  font-size: 22rpx;
}

.card {
  border-radius: 28rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.92), rgba(8, 15, 28, 0.94));
  border: 1rpx solid rgba(148, 163, 184, 0.14);
  box-shadow: 0 18rpx 40rpx rgba(2, 6, 23, 0.28);
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #f8fafc;
}

.card-desc {
  margin-top: 8rpx;
  color: #94a3b8;
  font-size: 22rpx;
  line-height: 1.5;
}

.preset-row {
  display: flex;
  flex-wrap: wrap;
  margin: 20rpx 0 4rpx;
}

.preset-chip {
  margin: 0 12rpx 12rpx 0;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(148, 163, 184, 0.14);
  color: #cbd5e1;
  font-size: 24rpx;
}

.preset-chip.is-active {
  background: rgba(45, 212, 191, 0.16);
  border-color: rgba(45, 212, 191, 0.4);
  color: #ccfbf1;
}

.field-block {
  margin-top: 18rpx;
}

.label {
  margin-bottom: 10rpx;
  color: #94a3b8;
  font-size: 22rpx;
}

.segment {
  display: flex;
  padding: 6rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.04);
}

.segment-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 14rpx;
  color: #94a3b8;
  font-size: 24rpx;
}

.segment-item.is-active {
  background: rgba(45, 212, 191, 0.16);
  color: #ccfbf1;
}

.field-input,
.dialog-input {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  padding: 0 20rpx;
  background: #0b1220;
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  color: #f8fafc;
}

.input-placeholder {
  color: #64748b;
}

.url-preview {
  margin-top: 12rpx;
  color: #67e8f9;
  font-size: 20rpx;
  line-height: 1.5;
  word-break: break-all;
}

.token-tools {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 12rpx;
}

.ghost-btn {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.06);
  color: #cbd5e1;
  font-size: 22rpx;
}

.btn-row {
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
}

.primary-btn,
.secondary-btn {
  flex: 1;
  margin: 0;
  border-radius: 18rpx;
  font-size: 28rpx;
  text-align: center;
  line-height: 88rpx;
  height: 88rpx;
}

.primary-btn {
  background: #0f766e;
  color: #ecfdf5;
}

.secondary-btn {
  background: rgba(255, 255, 255, 0.08);
  color: #e2e8f0;
}

.is-disabled {
  opacity: 0.6;
}

.inline-status {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  color: #94a3b8;
  font-size: 22rpx;
}

.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

.status-on {
  background: #34d399;
}

.status-off {
  background: #f87171;
}

.error-text {
  margin-top: 14rpx;
  color: #fca5a5;
  line-height: 1.5;
}

.strip-card {
  padding-bottom: 22rpx;
}

.strip-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.strip-title-wrap {
  flex: 1;
  min-width: 0;
}

.strip-kicker {
  color: #5eead4;
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.strip-title {
  margin-top: 8rpx;
  color: #f8fafc;
  font-size: 40rpx;
  font-weight: 700;
}

.strip-meta {
  margin-top: 8rpx;
  color: #94a3b8;
  font-size: 20rpx;
  line-height: 1.5;
}

.power-btn {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(15, 23, 42, 0.9);
  border: 2rpx solid rgba(148, 163, 184, 0.2);
}

.power-ring {
  position: absolute;
  inset: 8rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(148, 163, 184, 0.18);
}

.power-glyph {
  font-size: 36rpx;
  line-height: 1;
  color: #cbd5e1;
}

.power-caption {
  margin-top: 4rpx;
  font-size: 18rpx;
  color: #94a3b8;
}

.power-btn.is-on {
  border-color: rgba(52, 211, 153, 0.5);
  box-shadow: 0 0 24rpx rgba(52, 211, 153, 0.24);
}

.power-btn.is-on .power-ring {
  border-color: rgba(52, 211, 153, 0.7);
}

.power-btn.is-on .power-glyph,
.power-btn.is-on .power-caption {
  color: #6ee7b7;
}

.power-stage {
  margin-top: 22rpx;
  padding: 28rpx 20rpx 22rpx;
  border-radius: 24rpx;
  background:
    radial-gradient(circle at 50% 0%, rgba(45, 212, 191, 0.16), transparent 55%),
    rgba(2, 6, 23, 0.35);
  text-align: center;
}

.power-stage.is-on {
  background:
    radial-gradient(circle at 50% 0%, rgba(251, 191, 36, 0.2), transparent 52%),
    rgba(2, 6, 23, 0.28);
}

.power-readout {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 8rpx;
}

.power-number {
  color: #fff7ed;
  font-size: 88rpx;
  font-weight: 720;
  line-height: 1;
}

.power-unit {
  margin-bottom: 12rpx;
  color: #fdba74;
  font-size: 28rpx;
  font-weight: 700;
}

.power-caption-lg {
  margin-top: 8rpx;
  color: #cbd5e1;
  font-size: 22rpx;
}

.metric-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 22rpx;
}

.metric-tile {
  padding: 16rpx 8rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.04);
}

.metric-label {
  color: #94a3b8;
  font-size: 20rpx;
}

.metric-value {
  margin-top: 6rpx;
  color: #f8fafc;
  font-size: 28rpx;
  font-weight: 700;
}

.metric-unit {
  margin-left: 4rpx;
  color: #94a3b8;
  font-size: 20rpx;
  font-weight: 500;
}

.metric-time {
  font-size: 24rpx;
}

.socket-section {
  margin-top: 22rpx;
}

.socket-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.socket-title {
  color: #f8fafc;
  font-size: 28rpx;
  font-weight: 700;
}

.socket-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.socket-card {
  min-height: 220rpx;
  padding: 20rpx 10rpx 16rpx;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(180deg, rgba(30, 41, 59, 0.72), rgba(15, 23, 42, 0.88));
  border: 1rpx solid rgba(148, 163, 184, 0.12);
}

.socket-card.is-on {
  background: linear-gradient(180deg, rgba(16, 185, 129, 0.2), rgba(15, 23, 42, 0.86));
  border-color: rgba(52, 211, 153, 0.32);
  box-shadow: 0 10rpx 24rpx rgba(16, 185, 129, 0.12);
}

.socket-face {
  width: 78rpx;
  height: 78rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: #020617;
  box-shadow: inset 0 0 0 6rpx rgba(15, 23, 42, 0.9);
}

.socket-hole {
  width: 10rpx;
  height: 24rpx;
  border-radius: 8rpx;
  background: #334155;
}

.socket-card.is-on .socket-face {
  box-shadow: 0 0 20rpx rgba(52, 211, 153, 0.28), inset 0 0 0 6rpx rgba(6, 78, 59, 0.7);
}

.socket-card.is-on .socket-hole {
  background: #34d399;
  box-shadow: 0 0 8rpx rgba(52, 211, 153, 0.7);
}

.socket-name {
  width: 100%;
  margin-top: 16rpx;
  color: #f8fafc;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.socket-state {
  margin-top: 6rpx;
  color: #94a3b8;
  font-size: 20rpx;
}

.socket-card.is-on .socket-state {
  color: #6ee7b7;
}

.empty-socket,
.empty-card {
  text-align: center;
}

.empty-socket {
  padding: 28rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.04);
  color: #94a3b8;
}

.empty-card {
  padding: 56rpx 28rpx;
}

.empty-icon {
  font-size: 64rpx;
  color: #2dd4bf;
}

.empty-title {
  margin-top: 12rpx;
  color: #f8fafc;
  font-size: 34rpx;
  font-weight: 700;
}

.empty-desc {
  margin-top: 12rpx;
  color: #94a3b8;
  font-size: 24rpx;
  line-height: 1.7;
}

.dialog-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: rgba(2, 6, 23, 0.72);
}

.dialog-card {
  width: 100%;
  border-radius: 28rpx;
  padding: 28rpx 24rpx;
  background: linear-gradient(180deg, #111827, #0b1220);
  border: 1rpx solid rgba(148, 163, 184, 0.16);
}

.dialog-title {
  color: #f8fafc;
  font-size: 34rpx;
  font-weight: 700;
}

.dialog-subtitle {
  margin: 10rpx 0 20rpx;
  color: #94a3b8;
  font-size: 22rpx;
  line-height: 1.5;
}

.muted {
  color: #94a3b8;
  font-size: 22rpx;
}


